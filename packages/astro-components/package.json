{
  "name": "@prosefly/astro-components",
  "version": "0.5.0",
  "type": "module",
  "license": "BSD-3-Clause",
  "keywords": [
    "astro",
    "astro-component",
    "withastro",
    "ui",
    "icon",
    "icons",
    "utility",
    "markdown",
    "mdx"
  ],
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "tsc -p ./tsconfig.build.json --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm run build",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prosefly/astro-components.git",
    "directory": "packages/astro-components"
  },
  "homepage": "https://prosefly.dev/docs/astro-components/",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "default": "./dist/icon/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "default": "./dist/markdown/index.js"
    },
    "./expressive-code": {
      "types": "./dist/expressive-code/index.d.ts",
      "default": "./dist/expressive-code/index.js"
    },
    "./markdown/image-gallery.css": "./dist/markdown/image-gallery.css",
    "./markdown/image-gallery.js": "./dist/markdown/image-gallery.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@expressive-code/core": "^0.44.0",
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@expressive-code/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@iconify/utils": "^3.1.4",
    "rehype": "^13.0.2",
    "rehype-format": "^5.0.1",
    "remark-directive": "^4.0.0"
  },
  "devDependencies": {
    "@expressive-code/core": "^0.44.0",
    "astro": "7.1.0",
    "@types/node": "latest",
    "typescript": "^6.0.3",
    "vite": "latest"
  }
}
