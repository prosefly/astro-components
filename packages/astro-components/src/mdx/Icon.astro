---
import { getIconData, iconToSVG, replaceIDs } from '@iconify/utils';
import {
  loadIconCollection,
  parseIconName,
} from '../icon/iconify';

interface Props {
  name: string;
  title?: string;
  size?: number | string;
  width?: number | string;
  height?: number | string;
  class?: string;
  focusable?: string;
  apiBase?: string;
}

const locals = Astro.locals as { proseflyIconApiBase?: string };

const {
  name,
  title,
  size,
  width = size ?? '1em',
  height = size ?? '1em',
  class: className,
  focusable = 'false',
  apiBase = locals.proseflyIconApiBase ?? 'https://api.iconify.design',
  ...attributes
} = Astro.props;
const { prefix, icon } = parseIconName(name);
const collection = await loadIconCollection(prefix, icon, apiBase);
const iconData = getIconData(collection, icon);

if (!iconData) {
  throw new Error(`Icon "${name}" was not found in the Iconify API response.`);
}

const renderedIcon = iconToSVG(iconData, { height, width });
const body = replaceIDs(renderedIcon.body);
const svgAttributes = {
  ...renderedIcon.attributes,
  ...attributes,
  'aria-hidden': title ? undefined : ('true' as const),
  focusable,
  role: title ? ('img' as const) : undefined,
};
---

<svg class:list={['pf-icon', className]} {...svgAttributes}>
  {title && <title>{title}</title>}
  <Fragment set:html={body} />
</svg>

<style>
  .pf-icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: -0.125em;
  }
</style>
