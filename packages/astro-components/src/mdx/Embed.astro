---
import '../styles/theme-tokens.css';
import type { HTMLAttributes } from 'astro/types';
import {
  formatPrice,
  formatRating,
  formatRatingCount,
  ratingLabel,
  resolveEmbed,
  type EmbedInput,
} from '../server/embed/index.js';

interface Props
  extends EmbedInput,
    Omit<HTMLAttributes<'figure'>, 'title'> {
  external?: boolean;
}

const {
  url,
  kind = 'auto',
  title,
  description,
  image,
  siteName,
  author,
  rating,
  price,
  fetch: shouldFetch = true,
  external = true,
  class: className,
  ...attributes
} = Astro.props;

const data = await resolveEmbed({
  url,
  kind,
  title,
  description,
  image,
  siteName,
  author,
  rating,
  price,
  fetch: shouldFetch,
});
const priceLabel = data.price ? formatPrice(data.price) : undefined;
const score = data.rating ? formatRating(data.rating) : undefined;
const scoreLabel = data.rating ? ratingLabel(data.rating) : undefined;
---

<figure
  {...attributes}
  class:list={['pf-embed', className]}
  data-pf-embed-kind={data.kind}
  data-pf-embed-provider={data.provider}
  data-pf-embed-source={data.source}
  data-pf-embed-type={data.embedType}
>
  {
    data.html ? (
      <div class="pf-embed__media" set:html={data.html} />
    ) : (
      <a
        class="pf-embed__card"
        href={data.url}
        rel={external ? 'noreferrer' : undefined}
        target={external ? '_blank' : undefined}
      >
        {data.image && (
          <div class="pf-embed__image">
            <img alt="" decoding="async" loading="lazy" src={data.image} />
          </div>
        )}
        <div class="pf-embed__body">
          {(data.siteName || data.author) && (
            <div class="pf-embed__eyebrow">
              {data.siteName}
              {data.siteName && data.author && <span aria-hidden="true"> · </span>}
              {data.author}
            </div>
          )}
          {data.title && <p class="pf-embed__title">{data.title}</p>}
          {data.description && <p class="pf-embed__description">{data.description}</p>}
          {(score || priceLabel) && (
            <div class="pf-embed__facts">
              {score && (
                <span aria-label={scoreLabel} class="pf-embed__rating">
                  <span aria-hidden="true" class="pf-embed__star">★</span>
                  {score}
                  {data.rating?.count !== undefined && (
                    <span class="pf-embed__count">
                      ({formatRatingCount(data.rating.count)})
                    </span>
                  )}
                </span>
              )}
              {priceLabel && <span class="pf-embed__price">{priceLabel}</span>}
            </div>
          )}
          {!data.title && <span class="pf-embed__url">{data.url}</span>}
        </div>
      </a>
    )
  }
</figure>

<style is:global>
  .pf-embed {
    --pf-embed-radius: var(--pf-radius-lg);
    box-sizing: border-box;
    color: var(--pf-embed-color, var(--pf-text));
    container-type: inline-size;
    font-family: var(--pf-embed-font-family, var(--pf-font-sans));
    margin-block: var(--pf-embed-margin, 1.5rem);
    max-width: 100%;
  }

  .pf-embed__media {
    max-width: 100%;
    overflow: hidden;
  }

  .pf-embed__media iframe {
    border: 0;
    margin: 0;
    display: block;
    max-width: 100%;
    width: 100%;
  }

  .pf-embed__media img {
    display: block;
    height: auto;
    margin: 0;
    max-width: 100%;
  }

  .pf-embed__media blockquote {
    margin-block: 0;
    max-width: 100%;
  }

  .pf-embed__media .twitter-tweet {
    line-height: 1.25;
  }

  .pf-embed__card {
    background: var(--pf-embed-background, var(--pf-background));
    border: 1px solid var(--pf-embed-border-color, var(--pf-border-subtle));
    border-radius: var(--pf-embed-radius);
    color: inherit;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .pf-embed__card:hover {
    border-color: var(--pf-embed-hover-border-color, var(--pf-accent));
  }

  .pf-embed__card:focus-visible {
    outline: 2px solid var(--pf-embed-focus-color, var(--pf-accent));
    outline-offset: 2px;
  }

  .pf-embed__image {
    background: var(--pf-embed-image-background, var(--pf-surface));
    min-width: 0;
    padding: var(--pf-embed-padding, 1rem);
    overflow: hidden;
  }

  .pf-embed[data-pf-embed-kind="link"] .pf-embed__image {
    padding: 0;
  }

  .pf-embed__image img {
    height: 100%;
    margin: 0;
    object-fit: cover;
    width: 100%;
    border-radius: calc(var(--pf-embed-radius) - var(--pf-embed-padding, 1rem) / 1.5);
  }

  .pf-embed__body {
    align-content: center;
    display: grid;
    gap: var(--pf-embed-body-gap, 0.375rem);
    min-width: 0;
    padding: var(--pf-embed-padding, 1rem);
  }

  .pf-embed__eyebrow,
  .pf-embed__description,
  .pf-embed__url,
  .pf-embed__count {
    color: var(--pf-embed-muted-color, var(--pf-text-muted));
  }

  .pf-embed__eyebrow {
    font-size: var(--pf-embed-eyebrow-size, 0.75rem);
    line-height: 1.4;
  }

  .pf-embed__title {
    color: var(--pf-embed-title-color, var(--pf-text-strong));
    font-size: var(--pf-embed-title-size, 1rem);
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
  }

  .pf-embed__description {
    display: -webkit-box;
    font-size: var(--pf-embed-description-size, 0.875rem);
    line-height: 1.55;
    font-weight: 400;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--pf-embed-description-lines, 3);
  }

  .pf-embed__facts {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.875rem;
    margin-block-start: 0.25rem;
  }

  .pf-embed__rating,
  .pf-embed__price {
    align-items: center;
    display: inline-flex;
    font-size: 0.8125rem;
    font-weight: 600;
    gap: 0.25rem;
  }

  .pf-embed__star {
    color: var(--pf-embed-rating-color, var(--pf-warning));
  }

  .pf-embed__price {
    color: var(--pf-embed-price-color, var(--pf-text-strong));
  }

  .pf-embed__url {
    font-size: 0.875rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @container (min-width: 30rem) {
    .pf-embed__card:has(.pf-embed__image) {
      grid-template-columns: minmax(8rem, var(--pf-embed-image-width, 11rem)) minmax(0, 1fr);
    }
  }
</style>
