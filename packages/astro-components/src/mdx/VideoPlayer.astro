---
import type { HTMLAttributes } from 'astro/types';
import mediaPlayerScriptUrl from '../client/media-player.js?url&no-inline';
import '../styles/theme-tokens.css';
import Icon from './Icon.astro';
import '../styles/media-player.css';
import {
  formatDuration,
  resolveArtwork,
  type MediaArtwork,
  type MediaDuration,
} from '../server/media-player.js';

interface Props
  extends Omit<
    HTMLAttributes<'video'>,
    'controls' | 'poster' | 'preload' | 'title'
  > {
  title?: string;
  creator?: string;
  poster?: MediaArtwork;
  duration?: MediaDuration;
  aspectRatio?: string;
  objectFit?: 'contain' | 'cover';
  preload?: 'none' | 'metadata' | 'auto';
}

const {
  title,
  creator,
  poster,
  duration,
  aspectRatio = '16 / 9',
  objectFit = 'contain',
  preload = 'metadata',
  playsinline = true,
  class: className,
  ...mediaAttributes
} = Astro.props;
const posterSrc = resolveArtwork(poster);
const durationLabel = formatDuration(duration);
const ariaLabel = mediaAttributes['aria-label'] ?? title ?? 'Video player';
---

<figure
  class:list={['pf-video-player', className]}
  data-pf-media-duration={durationLabel}
  data-pf-media-player
  style={`--pf-video-player-aspect-ratio: ${aspectRatio}; --pf-video-player-object-fit: ${objectFit};`}
>
  <div class="pf-video-player__surface">
    <video
      {...mediaAttributes}
      aria-label={ariaLabel}
      class="pf-video-player__media"
      controls
      playsinline={playsinline}
      poster={posterSrc}
      preload={preload}
    >
      <slot />
      Your browser does not support the video element.
    </video>

    <div
      aria-label="Video controls"
      class="pf-media-player__controls pf-video-player__controls"
      role="group"
    >
      <button
        aria-label="Play"
        class="pf-media-player__button pf-media-player__play"
        data-pf-media-play
        type="button"
      >
        <span class="pf-media-player__play-icon">
          <Icon class="pf-media-icon" name="ri:play-fill" />
        </span>
        <span class="pf-media-player__pause-icon">
          <Icon class="pf-media-icon" name="ri:pause-fill" />
        </span>
      </button>

      <input
        aria-label="Seek"
        class="pf-media-player__seek"
        data-pf-media-seek
        disabled
        max="100"
        min="0"
        step="0.1"
        type="range"
        value="0"
      />

      <span class="pf-media-player__time">
        <time data-pf-media-current-time>0:00</time>
        <span aria-hidden="true" class="pf-media-player__time-separator"> / </span>
        <time data-pf-media-duration>{durationLabel}</time>
      </span>

      <button
        aria-label="Mute"
        class="pf-media-player__button"
        data-pf-media-mute
        type="button"
      >
        <span class="pf-media-player__volume-icon">
          <Icon class="pf-media-icon" name="ri:volume-up-fill" />
        </span>
        <span class="pf-media-player__muted-icon">
          <Icon class="pf-media-icon" name="ri:volume-mute-fill" />
        </span>
      </button>

      <button
        aria-label="Enter fullscreen"
        class="pf-media-player__button"
        data-pf-media-fullscreen
        type="button"
      >
        <Icon class="pf-media-icon" name="ri:fullscreen-line" />
      </button>
    </div>
  </div>

  {
    (title || creator) && (
      <figcaption class="pf-media-player__metadata pf-video-player__caption">
        {title && <p class="pf-media-player__title">{title}</p>}
        {creator && <p class="pf-media-player__byline">{creator}</p>}
      </figcaption>
    )
  }
</figure>

<script is:inline type="module" src={mediaPlayerScriptUrl}></script>
