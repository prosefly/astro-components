---
import '../styles/theme-tokens.css';
import Icon from './Icon.astro';
import { extractImages } from '../server/image-gallery.js';

const content = await Astro.slots.render('default');
const images = extractImages(content);
const hasMultipleImages = images !== undefined && images.length > 1;
---

{
  images ? (
    <figure
      class="pf-image-gallery"
      data-image-count={images.length}
    >
      {hasMultipleImages ? (
        <pf-image-gallery class="not-prose">
          <div class="pf-image-gallery__track" data-pf-image-gallery-track>
            {images.map((image) => (
              <span class="pf-image-gallery__item">
                <Fragment set:html={image.html} />
              </span>
            ))}
          </div>
          <div class="pf-image-gallery__footer">
            <span
              aria-live="polite"
              aria-atomic="true"
              class="pf-image-gallery__caption"
              data-pf-image-gallery-caption
            >{images[0].alt}</span>
            <div class="pf-image-gallery__navigation">
              <button
                aria-label="Previous image"
                class="pf-image-gallery__button"
                data-pf-image-gallery-button="previous"
                disabled
                type="button"
              >
                <Icon name="lucide:arrow-left" />
              </button>
              <button
                aria-label="Next image"
                class="pf-image-gallery__button"
                data-pf-image-gallery-button="next"
                type="button"
              >
                <Icon name="lucide:arrow-right" />
              </button>
            </div>
          </div>
        </pf-image-gallery>
      ) : (
        <Fragment set:html={images[0].html} />
      )}
    </figure>
  ) : (
    <Fragment set:html={content} />
  )
}

<script>
  import '../client/image-gallery';
</script>

<style>
  pf-image-gallery {
    display: block;
  }

  .pf-image-gallery {
    margin-inline: 0;
  }

  pf-image-gallery :global(img) {
    display: block;
    margin: 0;
    width: 100%;
  }

  .pf-image-gallery:not([data-image-count="1"]) {
    --pf-image-gallery-preview-width: 4rem;
    position: relative;
  }

  .pf-image-gallery__track {
    align-items: flex-start;
    display: flex;
    gap: 0.75rem;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-behavior: smooth;
    scroll-padding-inline: 0;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .pf-image-gallery__track::-webkit-scrollbar {
    display: none;
  }

  .pf-image-gallery__item {
    align-items: center;
    aspect-ratio: var(--pf-image-gallery-ratio, 3 / 2);
    border-radius: min(var(--pf-radius-lg, 0.75rem), 1rem);
    display: flex;
    flex: 0 0 auto;
    justify-content: center;
    overflow: hidden;
    scroll-snap-align: start;
    width: calc(100% - var(--pf-image-gallery-preview-width));
  }

  .pf-image-gallery__item :global(img) {
    border-radius: inherit;
    height: 100%;
    object-fit: contain;
    width: 100%;
  }

  .pf-image-gallery__footer {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-block-start: 0.5rem;
  }

  .pf-image-gallery__caption {
    color: var(--pf-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .pf-image-gallery__navigation {
    align-items: center;
    display: none;
    flex-shrink: 0;
    gap: 0.25rem;
  }

  pf-image-gallery[data-pf-image-gallery-ready] .pf-image-gallery__navigation {
    display: flex;
  }

  @media (max-width: 640px) {
    .pf-image-gallery:not([data-image-count="1"]) {
      --pf-image-gallery-preview-width: 2.75rem;
    }
  }

  .pf-image-gallery__button {
    align-items: center;
    appearance: none;
    background: transparent;
    border: 0;
    border-radius: var(--pf-radius-sm);
    color: var(--pf-text-muted);
    cursor: pointer;
    display: inline-flex;
    height: 1.75rem;
    justify-content: center;
    line-height: 1;
    padding: 0;
    transition:
      background-color 160ms ease,
      color 160ms ease;
    width: 1.75rem;
  }

  .pf-image-gallery__button:hover:not(:disabled) {
    background: var(--pf-surface);
    color: var(--pf-text-strong);
  }

  .pf-image-gallery__button:disabled {
    color: color-mix(in oklab, var(--pf-text-muted) 40%, var(--pf-background));
    cursor: not-allowed;
  }

  .pf-image-gallery__button:focus-visible {
    outline: 2px solid var(--pf-accent);
    outline-offset: 2px;
  }

  .pf-image-gallery__button > svg {
    display: inline-block;
    height: 1.125rem;
    width: 1.125rem;
  }
</style>
