{
  "name": "astro-components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "BSD-3-Clause",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run build:pkg && astro build",
    "build:pkg": "pnpm --dir packages/astro-components build",
    "preview": "astro preview",
    "check": "pnpm run lint && pnpm run check:pkg && pnpm run check:site",
    "check:pkg": "pnpm --dir packages/astro-components check",
    "check:site": "astro check",
    "lint": "eslint \"**/*.{js,mjs,ts,astro}\"",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm --dir packages/astro-components test"
  },
  "dependencies": {
    "@astrojs/check": "latest",
    "@prosefly/astro-components": "workspace:*",
    "@prosefly/astro-theme-lotus": "^0.8.0",
    "astro": "^7.3.8",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  }
}
